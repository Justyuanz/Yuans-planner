# Yuan's Planner does not require secrets by default.
# Copy this file to `.env` for local overrides, or set the same variables in your host.

# Bind address for the Python server.
YUAN_PLANNER_HOST=0.0.0.0

# Port for local/dev/prod runs.
YUAN_PLANNER_PORT=8765

# Optional SQLite path.
# Relative paths are resolved from the project root.
# For production, point this at persistent storage.
YUAN_PLANNER_DB_PATH=data/planner.db

# Planner timezone for reminders and scheduled items.
YUAN_PLANNER_TIMEZONE=Europe/Helsinki

# Optional OpenAI-backed mascot chat
OPENAI_API_KEY=
YUAN_PLANNER_OPENAI_MODEL=gpt-5-mini
YUAN_PLANNER_OPENAI_TIMEOUT_SECONDS=20

# Optional Telegram reminders
# 1. Create a Telegram bot with BotFather and copy the token here.
# 2. Send a message to the bot from your Telegram account.
# 3. Find your chat ID and paste it below.
YUAN_PLANNER_TELEGRAM_ENABLED=0
YUAN_PLANNER_TELEGRAM_BOT_TOKEN=
YUAN_PLANNER_TELEGRAM_CHAT_ID=
